{
  "name": "threatfusion",
  "private": true,
  "version": "1.0.0",
  "description": "ThreatFusion AI full-stack development workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --prefix src/frontend",
    "install:frontend": "node scripts/install-frontend.mjs",
    "install:backend": "node scripts/setup-backend.mjs",
    "postinstall": "npm run install:frontend && npm run install:backend",
    "test:backend": "node scripts/run-backend-tests.mjs"
  }
}
